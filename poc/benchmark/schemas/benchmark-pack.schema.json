{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckes.local/schemas/benchmark-pack.schema.json",
  "title": "BenchmarkPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pack", "executionRequirements", "canonicalSeedMaterial", "scenarios"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "pack": { "$ref": "#/$defs/packMeta" },
    "executionRequirements": { "$ref": "#/$defs/executionRequirements" },
    "canonicalSeedMaterial": {
      "type": "array",
      "items": { "$ref": "#/$defs/seedEntry" }
    },
    "canonicalSeedRef": { "$ref": "#/$defs/externalSeedRef" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "packMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "name", "suiteClass", "packVersion", "status", "description", "contentHash"],
      "properties": {
        "packId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "suiteClass": { "type": "string", "enum": ["anchor", "statistical", "challenge"] },
        "packVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "reviewed", "released", "retired"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonicalSeedHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "generationMethod": { "type": "string" },
        "generatingTool": { "type": "string" },
        "promptTemplateVersion": { "type": "string" },
        "humanReviewStatus": { "type": "string" },
        "domains": { "type": "array", "items": { "type": "string" } },
        "subdomains": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "compatibleHarnessVersions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "executionRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedExecutionModes", "defaultExecutionMode", "databaseProfile"],
      "properties": {
        "supportedExecutionModes": {
          "type": "array",
          "items": { "type": "string", "enum": ["full_pipeline", "decision_slice"] },
          "minItems": 1
        },
        "defaultExecutionMode": { "type": "string", "enum": ["full_pipeline", "decision_slice"] },
        "databaseProfile": { "type": "string", "enum": ["clean", "warm"] },
        "scenarioIsolationRequired": { "type": "boolean" },
        "retrievalModesAllowed": {
          "type": "array",
          "items": { "type": "string", "enum": ["mocked", "hinted", "live", "deterministic_fixture"] }
        },
        "llmPolicy": { "type": "string", "enum": ["required", "allowed", "not_required", "prohibited"] },
        "costCeilingUsd": { "type": "number", "minimum": 0 },
        "maxConcurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "seedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedId", "entityType", "label", "statement"],
      "properties": {
        "seedId": { "type": "string" },
        "entityType": { "type": "string", "enum": ["entity", "assertion", "concept"] },
        "label": { "type": "string" },
        "statement": { "type": "string" },
        "domain": { "type": "string" },
        "applicability": { "type": "object", "additionalProperties": true }
      }
    },
    "externalSeedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedArtifactId", "version", "contentHash", "resolver", "loadBehavior", "hashMismatchPolicy"],
      "properties": {
        "seedArtifactId": { "type": "string" },
        "version": { "type": "string" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resolver": { "type": "string" },
        "loadBehavior": { "type": "string", "enum": ["copy_into_isolated_db", "reference_only"] },
        "hashMismatchPolicy": { "type": "string", "enum": ["fail", "refuse_run"] }
      }
    },
    "identityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceKind"],
      "properties": {
        "referenceKind": { "type": "string", "enum": ["local", "external"] },
        "seedId": { "type": "string" },
        "externalId": { "type": "string" },
        "externalLocator": { "type": "string" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "title", "status", "suite", "executionMode", "expectedDecisionClass", "labelConfidenceClass"],
      "properties": {
        "scenarioId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "reviewed", "released", "retired"] },
        "suite": { "type": "string" },
        "domain": { "type": "string" },
        "subdomain": { "type": "string" },
        "executionMode": { "type": "string", "enum": ["full_pipeline", "decision_slice"] },
        "sourceText": { "type": "string" },
        "directCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateType", "text"],
          "properties": {
            "candidateType": { "type": "string" },
            "text": { "type": "string" }
          }
        },
        "candidateType": { "type": "string" },
        "context": { "type": "object", "additionalProperties": true },
        "applicability": { "type": "object", "additionalProperties": true },
        "expectedDecisionClass": {
          "type": "string",
          "enum": [
            "match_existing",
            "related_distinct",
            "propose_new_identity",
            "qualify_existing",
            "contradict_existing",
            "revalidation_candidate",
            "defer_llm",
            "defer_human",
            "reject_source_specific"
          ]
        },
        "expectedIdentity": { "$ref": "#/$defs/identityRef" },
        "relatedIdentities": { "type": "array", "items": { "$ref": "#/$defs/identityRef" } },
        "mustNotMatchIdentities": { "type": "array", "items": { "$ref": "#/$defs/identityRef" } },
        "acceptableAlternatives": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "llmPolicy": { "type": "string", "enum": ["required", "allowed", "not_required", "prohibited"] },
        "maxCostTier": { "type": "string" },
        "expectedRationale": { "type": "string" },
        "labelConfidenceClass": {
          "type": "string",
          "enum": [
            "deterministic_by_construction",
            "strong_expectation",
            "acceptable_result_set",
            "expected_deferral",
            "human_review_required",
            "research_unresolved"
          ]
        },
        "transformationType": { "type": "string" },
        "failureSeverity": { "type": "string" },
        "ckesParRefs": { "type": "array", "items": { "type": "string" } },
        "validationMatrixRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string" },
        "signature": { "type": "string" },
        "attestation": { "type": "string" }
      }
    }
  }
}
